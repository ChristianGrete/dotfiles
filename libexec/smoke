#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Assert that a freshly built prefix loads cleanly in an interactive shell and
# exposes its public API. Run after "make build". Zsh is skipped when absent, so
# this stays useful on machines without zsh while CI still exercises both.
#
# The shell must be interactive (-i) or completions.bash returns early via its
# own guard. TERM_PROGRAM=vscode suppresses fastfetch during the run.

smoke_bash() {
  local prefix="$REPO_DIR/build/bash"

  if [[ ! -f "$prefix/home/rc.bash" ]]; then
    printf 'smoke: build/bash not found; run "make build" first.\n' >&2
    return 1
  fi

  TERM_PROGRAM='vscode' DOTFILES="$prefix" bash --norc --noprofile -ic '
    . "$DOTFILES/home/rc.bash"
    fail() { printf "smoke(bash): %s.\n" "$1" >&2; exit 1; }
    [[ -n "$DOTFILES_OS" ]]              || fail "DOTFILES_OS unset (bootstrap)"
    declare -F git_branch > "/dev/null"  || fail "git_branch missing (functions)"
    alias gb > "/dev/null" 2>&1          || fail "gb alias missing (aliases)"
    complete -p gp > "/dev/null" 2>&1    || fail "gp completion missing (completions)"
    declare -F __dotfiles_prompt_command > "/dev/null" || fail "prompt not set up"
  ' || return 1

  printf 'smoke: bash ok.\n'
}

smoke_zsh() {
  if ! command -v 'zsh' > '/dev/null' 2>&1; then
    printf 'smoke: zsh not installed; skipping.\n'
    return 0
  fi

  local prefix="$REPO_DIR/build/zsh"

  if [[ ! -f "$prefix/home/rc.zsh" ]]; then
    printf 'smoke: build/zsh not found; run "make build" first.\n' >&2
    return 1
  fi

  TERM_PROGRAM='vscode' DOTFILES="$prefix" zsh -f -ic '
    . "$DOTFILES/home/rc.zsh"
    fail() { printf "smoke(zsh): %s.\n" "$1" >&2; exit 1; }
    [[ -n "$DOTFILES_OS" ]]                       || fail "DOTFILES_OS unset (bootstrap)"
    (( $+functions[git_branch] ))                 || fail "git_branch missing (functions)"
    alias gb > "/dev/null" 2>&1                   || fail "gb alias missing (aliases)"
    (( $+functions[compdef] ))                    || fail "compinit did not run (completions)"
    (( $+functions[__dotfiles_prompt_precmd] ))   || fail "prompt not set up"
  ' || return 1

  printf 'smoke: zsh ok.\n'
}

smoke_bash
smoke_zsh

printf 'smoke: all good.\n'
