#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CHANGELOG_FILE="$REPO_DIR/CHANGELOG.md"

# Stamp a new release section into CHANGELOG.md, listing commits since the last
# tag under a versioned heading. The [Unreleased] section is kept above it.

version="${1:-}"

if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  printf 'stamp: invalid arguments.\n' >&2
  printf '  usage: libexec/stamp X.Y.Z\n' >&2
  exit 1
fi

if [[ ! -f "$CHANGELOG_FILE" ]]; then
  printf 'stamp: CHANGELOG.md not found: %s\n' "$CHANGELOG_FILE" >&2
  exit 1
fi

if ! grep -q '^## \[Unreleased\]' "$CHANGELOG_FILE"; then
  printf 'stamp: CHANGELOG.md has no "## [Unreleased]" section.\n' >&2
  exit 1
fi

date="$(date +%F)"
entries="$("$REPO_DIR/libexec/changelog")"

# Fall back to a placeholder when there are no commits since the last tag.
[[ -n "$entries" ]] || entries='- No notable changes.'

section="## [$version] - $date"$'\n\n'"$entries"

# Insert after [Unreleased]; ENVIRON, unlike awk -v, keeps backslashes intact.
block="$section" awk '
  { print }
  /^## \[Unreleased\]/ && !done {
    print ""
    print ENVIRON["block"]
    done = 1
  }
' "$CHANGELOG_FILE" > "${CHANGELOG_FILE}.tmp"
mv "${CHANGELOG_FILE}.tmp" "$CHANGELOG_FILE"

printf 'stamp: CHANGELOG.md stamped with version %s.\n' "$version"
